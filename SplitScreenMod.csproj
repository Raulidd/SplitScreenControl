<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SplitScreenControl</AssemblyName>
    <RootNamespace>SplitScreenControl</RootNamespace>
